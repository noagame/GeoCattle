# Generar secretos: python3 scripts/configure.py
COMPOSE_PROJECT_NAME=geocattle-simulation
APP_ENV=simulation
SIMULATION_ENABLED=true
POSTGRES_DB=geocattle_simulation
POSTGRES_USER=geocattle
POSTGRES_PASSWORD=GENERATE_WITH_CONFIGURE
APP_DATABASE_PASSWORD=GENERATE_WITH_CONFIGURE
SESSION_SECRET=GENERATE_WITH_CONFIGURE
INGEST_KEY=GENERATE_WITH_CONFIGURE
# UUID del predio cuando hay varios predios físicos activos.
# INGEST_FARM_ID=00000000-0000-4000-8000-000000000001
DEMO_PASSWORD=GENERATE_WITH_CONFIGURE
COOKIE_SECURE=false
# Exigir TOTP al iniciar sesión como administrador en simulación o desarrollo.
ADMIN_LOGIN_MFA=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# Hosts de API separados por comas. En producción con túnel incluye el dominio
# público, localhost y 127.0.0.1 para los healthchecks.
ALLOWED_HOSTS=
# Solo para el perfil cloudflare. Copiar el token real al archivo privado.
# TUNNEL_TOKEN=TOKEN_FICTICIO_DE_CLOUDFLARE
WEB_PORT=8080
TLS_PORT=8443
DB_PORT=55432
# MQTT y LoRaWAN se activan con --profile iot o --profile lorawan en docker_project.py.
MQTT_USERNAME=geocattle
MQTT_PASSWORD=GENERATE_WITH_CONFIGURE
MQTT_PORT=1884
MQTT_TOPIC=application/+/device/+/event/up,geocattle/academic/telemetry
MQTT_SPOOL_PATH=/data/mqtt-spool.sqlite3
CHIRPSTACK_DB_PASSWORD=GENERATE_WITH_CONFIGURE
CHIRPSTACK_API_SECRET=GENERATE_WITH_CONFIGURE
CHIRPSTACK_PORT=8081
CONFIG_DOWNLINK_ENABLED=false
CONFIG_CODEC_VALIDATED=false
CHIRPSTACK_APPLICATION_ID=
CONFIG_FPORT=10
# Permite probar la alerta térmica con lecturas físicas en desarrollo.
PROTOTYPE_TEMPERATURE_ENABLED=false
# Sin proveedor configurado, los avisos permanecen pendientes localmente.
NOTIFICATION_WEBHOOK_URL=
# Correo de invitación y confirmación. Ejemplo ficticio, úsalo solo como plantilla.
INVITATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=geocattle@example.invalid
SMTP_PASSWORD=REEMPLAZAR_EN_EL_ARCHIVO_PRIVADO
SMTP_FROM=geocattle@example.invalid
SMTP_TIMEOUT_SECONDS=8
INVITATION_BASE_URL=https://geocattle.example.invalid

# Opcional: clave externa para cifrar MFA. Si se omite se deriva de SESSION_SECRET.
# Conservar estable y respaldar fuera de la BD; cambiarla requiere re-enrolamiento MFA.
MFA_ENCRYPTION_KEY=

# Modo espejo. Usa una clave compartida generada en los archivos privados.
MIRROR_MODE=off
MIRROR_SYNC_KEY=
MIRROR_SERVER_URL=https://geocattle.example.invalid
MIRROR_ACCESS_ID=
MIRROR_ACCESS_SECRET=
MIRROR_REMOTE_ADMIN=true
MIRROR_REMOTE_CHANGES=true
MIRROR_SOURCE_ENVIRONMENT=development
MIRROR_SOURCE=campo
