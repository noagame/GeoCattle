# Generar secretos: python3 scripts/configure.py
COMPOSE_PROJECT_NAME=geocattle-simulation
APP_ENV=simulation
SIMULATION_ENABLED=true
POSTGRES_DB=geocattle_simulation
POSTGRES_USER=geocattle
POSTGRES_PASSWORD=GENERATE_WITH_CONFIGURE
APP_DATABASE_PASSWORD=GENERATE_WITH_CONFIGURE
SESSION_SECRET=GENERATE_WITH_CONFIGURE
INGEST_KEY=GENERATE_WITH_CONFIGURE
DEMO_PASSWORD=GENERATE_WITH_CONFIGURE
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
WEB_PORT=8080
TLS_PORT=8443
DB_PORT=55432
MQTT_USERNAME=geocattle
MQTT_PASSWORD=GENERATE_WITH_CONFIGURE
MQTT_PORT=1884
MQTT_TOPIC=application/+/device/+/event/up,geocattle/academic/telemetry
MQTT_SPOOL_PATH=/data/mqtt-spool.sqlite3
CHIRPSTACK_DB_PASSWORD=GENERATE_WITH_CONFIGURE
CHIRPSTACK_API_SECRET=GENERATE_WITH_CONFIGURE
CHIRPSTACK_PORT=8081
CONFIG_DOWNLINK_ENABLED=false
CONFIG_CODEC_VALIDATED=false
CHIRPSTACK_APPLICATION_ID=
CONFIG_FPORT=10
# Sin proveedor configurado, los avisos permanecen pendientes localmente.
NOTIFICATION_WEBHOOK_URL=

# Opcional: clave externa para cifrar MFA. Si se omite se deriva de SESSION_SECRET.
# Conservar estable y respaldar fuera de la BD; cambiarla requiere re-enrolamiento MFA.
MFA_ENCRYPTION_KEY=
