  usecase "CU-13\nInvitar y administrar colaboradores" as CU_13
  usecase "CU-20\nAprobar o rechazar solicitud" as CU_20
  usecase "CU-15\nConsultar mapa del predio" as CU_15
  usecase "CU-17\nRegistrar vacuna o antibiótico por trabajador" as CU_17
  usecase "CU-23\nGestionar ficha sanitaria" as CU_23
  usecase "CU-26\nRecibir telemetría" as CU_26
